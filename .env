# Root .env file - Only for Docker Compose
# This file is used by docker-compose.yml to pass environment variables to services
# Individual services (backend, frontend, admin) have their own .env files

# PostgreSQL Database
DB_NAME=eximpo
DB_USER=postgres
DB_PASSWORD=postgres

# Backend will load backend/.env for its configuration
# Frontend will load frontend/.env for its configuration
# Admin will load admin/.env for its configuration

