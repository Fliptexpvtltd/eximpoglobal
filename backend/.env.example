# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Application
NODE_ENV=production
PORT=5000

# Authentication
JWT_SECRET=your-secure-jwt-secret-key-change-this
JWT_EXPIRES_IN=7d

# Brevo Email Service
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your Company Name
FRONTEND_URL=https://yourdomain.com

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CORS
CORS_ORIGIN=https://yourdomain.com

# Contabo Object Storage (S3-compatible)
CONTABO_ENDPOINT=https://sin1.contabostorage.com
CONTABO_ACCESS_KEY=your-access-key
CONTABO_SECRET_KEY=your-secret-key
CONTABO_BUCKET=your-bucket-name
CONTABO_BUCKET_ID=your-bucket-id
CONTABO_REGION=SIN

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
